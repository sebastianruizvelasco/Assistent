# AURA en hosting Apache (InfinityFree). Vite copia este archivo a dist/.htaccess.

<IfModule mod_rewrite.c>
  RewriteEngine On

  # El front llama a /api/assistant; en este hosting el proxy es un script PHP.
  RewriteRule ^api/assistant/?$ api/assistant.php [L]

  # Archivos y carpetas reales se sirven tal cual; cualquier otra ruta carga la app (SPA).
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # microphone=(self) es obligatorio para el dictado: con microphone=() el navegador
  # bloquea la Web Speech API aunque la persona conceda el permiso.
  Header always set Permissions-Policy "camera=(), microphone=(self), geolocation=(self)"
  # CSP: permite solo lo que la app necesita (Supabase, Google Identity, fuentes, clima y mapas).
  # Si añades un servicio nuevo, amplía connect-src o la función que lo use dejará de cargar.
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; form-action 'self'; script-src 'self' https://accounts.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://accounts.google.com https://www.googleapis.com https://api.open-meteo.com https://nominatim.openstreetmap.org; frame-src https://accounts.google.com; object-src 'none'; worker-src 'self'"
</IfModule>
