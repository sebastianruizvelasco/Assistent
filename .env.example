# --- Frontend (públicas; van dentro del JavaScript que descarga el navegador) ---
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-publica-supabase
# ID de cliente OAuth (tipo Web) para sincronizar con Google Calendar. No lleva secreto.
VITE_GOOGLE_CLIENT_ID=tu-id.apps.googleusercontent.com

# --- Proxy de IA en desarrollo (solo servidor; NUNCA con prefijo VITE_) ---
# Opcional y solo para `npm run dev`: en producción el proxy PHP no lee este archivo y usa la clave que
# cada usuario escribe en el panel del asistente. Estas variables no se incluyen en el build.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# URL pública de la web, usada como referer ante OpenRouter cuando el navegador no envía origen.
SITE_URL=https://auraassistent.freehosting.dev
