# --- Credenciales de Discord ---
# https://discord.com/developers/applications > tu aplicación > Bot > Reset Token
DISCORD_TOKEN=
# General Information > Application ID
DISCORD_APP_ID=
# Opcional: si lo rellenas, los comandos aparecen al instante en ese servidor.
# Si lo dejas vacío se registran globalmente (pueden tardar hasta 1 hora en aparecer).
DISCORD_GUILD_ID=

# --- Supabase (¡clave de servicio, no la anon!) ---
# Project Settings > API > service_role. Da acceso total: no la compartas ni la subas al repo.
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Modelo para /aura ---
# Cada persona usa la clave que tiene guardada en AURA. Estas variables son solo el respaldo
# cuando alguien vincula su cuenta pero aún no ha guardado ninguna clave en la web.
# Proveedor: openrouter | openai | gemini | anthropic
AI_PROVIDER=openrouter
AI_MODEL=openai/gpt-6.1-sol
AI_API_KEY=

# Zona horaria para interpretar «hoy», «mañana» y las horas de los eventos.
TZ=America/Bogota

# --- Chat ---
# El bot responde a los mensajes directos (privado). Si además quieres que responda en un
# canal concreto del servidor, pon aquí su ID; si lo dejas vacío, solo habla por privado.
DISCORD_CHAT_CHANNEL_ID=

# Opcional: canal donde avisar de las novedades del bot al arrancar.
DISCORD_LOG_CHANNEL_ID=
