# --- Credenciales de Discord ---
# https://discord.com/developers/applications > tu aplicación > Bot > Reset Token
DISCORD_TOKEN=
# General Information > Application ID
DISCORD_APP_ID=
# Opcional: si lo rellenas, los comandos aparecen al instante en ese servidor.
# Si lo dejas vacío se registran globalmente (pueden tardar hasta 1 hora en aparecer).
DISCORD_GUILD_ID=

# --- Supabase (¡clave de servicio, no la anon!) ---
# Project Settings > API > service_role. Da acceso total: no la compartas ni la subas al repo.
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Cuenta de AURA que atiende el bot ---
# Authentication > Users en Supabase, columna UUID. Una sola cuenta por bot.
AURA_USER_ID=

# Zona horaria para interpretar «hoy», «mañana» y las horas de los eventos.
TZ=America/Bogota

# Opcional: canal donde avisar de las novedades del bot al arrancar.
DISCORD_LOG_CHANNEL_ID=
